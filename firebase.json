{
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "hosting": {
      "port": 5002
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  },
  "hosting": {
    "public": "build/web",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Content-Security-Policy",
            "value": "frame-ancestors 'none'"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      },
      {
        "source": "/app/**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      },
      {
        "source": "/auth",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      },
      {
        "source": "/auth.html",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      },
      {
        "source": "/reset-password",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      },
      {
        "source": "/reset-password.html",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      },
      {
        "source": "/desktop-checkout",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      },
      {
        "source": "/desktop-checkout.html",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      },
      {
        "source": "/s/**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      },
      {
        "source": "/_astro/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/flutter_service_worker.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/app/flutter_service_worker.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/welcome",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/welcome.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/encryption",
        "destination": "/security",
        "type": 301
      },
      {
        "source": "/encryption.html",
        "destination": "/security",
        "type": 301
      },
      {
        "source": "/open-source",
        "destination": "/source-available-notes",
        "type": 301
      },
      {
        "source": "/open-source.html",
        "destination": "/source-available-notes",
        "type": 301
      },
      {
        "source": "/self-host",
        "destination": "/source-available-notes",
        "type": 301
      },
      {
        "source": "/self-host.html",
        "destination": "/source-available-notes",
        "type": 301
      },
      {
        "source": "/faqs",
        "destination": "/google-keep-alternative",
        "type": 301
      },
      {
        "source": "/faqs.html",
        "destination": "/google-keep-alternative",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/oauth/start",
        "function": "oauthStart"
      },
      {
        "source": "/oauth/callback",
        "function": "oauthCallback"
      },
      {
        "source": "/s/**",
        "destination": "/s/index.html"
      },
      {
        "source": "/app/**",
        "destination": "/app/index.html"
      }
    ]
  },
  "firestore": {
    "database": "better-keep",
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "better-keep-notes",
          "appId": "1:1058616680754:android:758305adecc3abdb7bf72b",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "better-keep-notes",
          "configurations": {
            "android": "1:1058616680754:android:758305adecc3abdb7bf72b",
            "ios": "1:1058616680754:ios:ba12e91b4b4600537bf72b",
            "macos": "1:1058616680754:ios:4674c5e161bef8027bf72b",
            "web": "1:1058616680754:web:b406c8db2f39a2d17bf72b"
          }
        }
      },
      "ios": {
        "default": {
          "projectId": "better-keep-notes",
          "appId": "1:1058616680754:ios:ba12e91b4b4600537bf72b",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "macos": {
        "default": {
          "projectId": "better-keep-notes",
          "appId": "1:1058616680754:ios:4674c5e161bef8027bf72b",
          "uploadDebugSymbols": false,
          "fileOutput": "macos/Runner/GoogleService-Info.plist"
        }
      }
    }
  }
}
