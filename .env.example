# Merge these settings and PUBLIC OAuth client IDs into the root Flutter .env.
# Build/run with --dart-define-from-file=.env. Never put provider client secrets
# or a storage encryption key in a client build.
# Optional explicit emulator hostname/IP; respected on web and simulators too.
# Leave empty to use the platform's local emulator address.
EMULATOR_HOST=
# HTTPS development origin for browser emulator proxies and native storage OAuth.
# Example: https://dev.example.test
# Setting this also enables the Astro development proxy; empty disables it.
# Native SDKs keep using EMULATOR_HOST and the emulator ports.
EMULATOR_WEB_ORIGIN=
# Google: enable Drive API and use clients in the SAME Google Cloud project as
# the existing integration, so its appDataFolder remains accessible.
# New Drive connections obtain their public configuration from Functions.
# Configure the Web OAuth client in functions/.env and .secret.local instead.
# Existing Apple/desktop encrypted grants remain supported without re-consent.
DROPBOX_CLIENT_ID=REPLACE_WITH_DROPBOX_APP_KEY
# Register Dropbox HTTPS redirects for production and development:
# https://betterkeep.app/oauth/storage/callback
# https://YOUR_FLUTTER_WEB_ORIGIN/oauth/storage/callback
# Native apps use the same hosted callback, then return to the app locally.
# EMULATOR_WEB_ORIGIN is required for native Dropbox setup in emulator mode.
# Development callback: https://dev.example.test/oauth/storage/callback
# Run npm run dev web and npm run dev hosting, then open the HTTPS /app URL.

# Upgrade compatibility only: retain the WEB_STORAGE_KEY used by the last
# released web build until legacy users have saved recovery passphrases.
# Read-only legacy decoding; new browser keys are never persisted.
# Web release builds require the original value. Do not generate a replacement.
WEB_STORAGE_KEY=
