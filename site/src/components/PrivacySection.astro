---
import { syncScreenshot } from '../data/home';
import DeviceFrame from './DeviceFrame.astro';
import Icon from './Icon.astro';
---

<section class="home-section privacy-section" id="privacy">
  <div class="security-story container">
    <div class="security-story__copy">
      <p class="eyebrow">Optional encrypted sync</p>
      <h2>Your notes, your choice of cloud.</h2>
      <p>
        Keep notes on one device, or sync through your own Google Drive,
        Dropbox, Nextcloud, or WebDAV storage. Manual sync is free. Lite and
        Pro sync automatically, and Pro adds Better Keep cloud.
      </p>
      <ul class="quiet-list">
        <li><Icon name="ShieldCheck" size={18} /> Encrypted on your device before syncing</li>
        <li><Icon name="MonitorSmartphone" size={18} /> You approve each device</li>
        <li><Icon name="KeyRound" size={18} /> Recovery passphrase if you lose a device</li>
      </ul>
      <div class="security-story__links">
        <a class="text-link" href="/security">Security details <Icon name="ArrowRight" size={17} /></a>
        <a class="text-link" href="/private-encrypted-notes">How private sync works <Icon name="ArrowRight" size={17} /></a>
        <a class="text-link" href="/pricing">Compare plans <Icon name="ArrowRight" size={17} /></a>
      </div>
    </div>
    <DeviceFrame {...syncScreenshot} class="security-story__device" />
  </div>
</section>
