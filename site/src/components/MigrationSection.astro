---
import { product } from '../data/product';
import Icon from './Icon.astro';
---

<section class="migration-section">
  <div class="migration-card container">
    <div class="migration-card__copy">
      <p class="eyebrow">Import from Google Keep</p>
      <h2>Bring your Google Keep notes.</h2>
      <p>
        Better Keep reads your Takeout ZIP on your device, skips notes you
        already imported, and lists anything it could not import.
      </p>
    </div>
    <a
      class="button button--secondary"
      href="/import/google-keep"
      data-analytics={product.analyticsGoals.keepImport}
    >
      Read the import guide <Icon name="ArrowRight" size={18} />
    </a>
  </div>
</section>
