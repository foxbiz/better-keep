---
import DocumentIcon from './DocumentIcon.astro';
import { product } from '../../data/product';

const plans = [
  { id: 'free', name: 'Free', benefit: 'Sync manually with your own storage.' },
  { id: 'lite', name: 'Lite', benefit: 'Keep your devices up to date automatically with your own storage.' },
  { id: 'pro', name: 'Pro', benefit: 'Use Better Keep cloud or your own storage, and lock as many notes as you like.' }
] as const;

const currencies = ['USD', 'INR'] as const;
function formatPrice(amount: number, currency: typeof currencies[number]) {
  return new Intl.NumberFormat(currency === 'INR' ? 'en-IN' : 'en-US', {
    style: 'currency', currency, minimumFractionDigits: amount % 100 === 0 ? 0 : 2
  }).format(amount / 100);
}

const features = [
  ['Local notes', 'Unlimited', 'Unlimited', 'Unlimited'],
  ['Manual external sync', 'Yes', 'Yes', 'Yes'],
  ['Automatic external sync', 'No', 'Yes', 'Yes'],
  ['Built-in cloud sync', 'No', 'No', 'Yes'],
  ['Locked Notes', 5, 5, 'Unlimited']
] as const;

const valueIcons = { Yes: 'check', No: 'circle-minus', Unlimited: 'infinity' } as const;
---

<section>
  <h2 id="plan-comparison">Feature Comparison</h2>
  <table class="comparison-table" aria-labelledby="plan-comparison">
    <thead><tr><th scope="col">Feature</th>{plans.map(plan => <th scope="col">{plan.name}</th>)}</tr></thead>
    <tbody>
      {features.map(([feature, ...values]) => (
        <tr>
          <th scope="row">{feature}</th>
          {values.map(value => (
            <td>
              {typeof value === 'number' ? value : (
                <span class="comparison-value" role="img" aria-label={value} title={value}>
                  <DocumentIcon name={valueIcons[value]} size={value === 'Unlimited' ? 22 : 18} />
                </span>
              )}
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
  <p>You can restore previously synced Better Keep cloud notes on every plan.</p>
</section>

<section class="web-pricing" hidden>
  <h2>Pricing</h2>
  <fieldset class="pricing-currencies">
    <legend>Billing currency</legend>
    {currencies.map(currency => (
      <label><input type="radio" form="pricing-upgrade" name="upgrade" value={currency} checked={currency === 'USD'} /> {currency}</label>
    ))}
  </fieldset>
  <div class="plan-grid">
    {plans.map(plan => (
      <article class="plan-card">
        <h3>{plan.name}</h3>
        {currencies.map(currency => {
          const price = plan.id === 'free' ? null : product.webPrices[plan.id][currency];
          return (
            <div data-currency={currency}>
              <strong>{formatPrice(price?.monthly ?? 0, currency)}</strong>
              {price && <> / month</>}
              {price && <small>or {formatPrice(price.yearly, currency)} per year</small>}
            </div>
          );
        })}
        <p>{plan.benefit}</p>
      </article>
    ))}
  </div>
  <form id="pricing-upgrade" action={product.webAppUrl} method="get">
    <button class="button" type="submit">Subscribe</button>
  </form>
</section>

<section>
  <h2>Sync with your own storage</h2>
  <p>In <strong>Sync provider</strong>, choose Google Drive, Dropbox, Nextcloud, or WebDAV. Select <strong>Sync now</strong> to send and receive changes on Free. Lite and Pro can sync changes automatically. Your notes and supported attachments are encrypted before upload.</p>
</section>

<section>
  <h2>Common questions</h2>
  <details class="faq-item">
    <summary class="faq-question">What happens if my subscription ends? <DocumentIcon name="chevron-down" /></summary>
    <p class="faq-answer">You can keep editing local notes and use manual sync with your storage. If you used Better Keep cloud, you can still download notes you previously synced. Uploading new changes to Better Keep cloud requires Pro.</p>
  </details>
  <details class="faq-item">
    <summary class="faq-question">Can I use Free offline? <DocumentIcon name="chevron-down" /></summary>
    <p class="faq-answer">Yes. Sign in once while online. You can then create and edit notes on your device offline. Reconnect when you want to sync.</p>
  </details>
  <details class="faq-item">
    <summary class="faq-question">How do I cancel or request a refund? <DocumentIcon name="chevron-down" /></summary>
    <p class="faq-answer">Use the store or payment provider where you subscribed. See the <a href="/cancellation-refund">cancellation and refund policy</a> for instructions.</p>
  </details>
</section>
