---
import DocumentIcon from './DocumentIcon.astro';
---

<div class="contact-grid">
      <div class="contact-card">
        <div class="contact-icon">
          <DocumentIcon name="mail" />
        </div>
        <h3>Email</h3>
        <p>For general inquiries, support requests, or feedback</p>
        <a href="mailto:contact@betterkeep.app" class="contact-link">contact@betterkeep.app</a>
      </div>

      <div class="contact-card">
        <div class="contact-icon">
          <DocumentIcon name="phone" />
        </div>
        <h3>Phone</h3>
        <p>Available for urgent support inquiries</p>
        <a href="tel:+919380679572" class="contact-link">+91 9380679572</a>
      </div>

      <div class="contact-card">
        <div class="contact-icon">
          <DocumentIcon name="map-pin" />
        </div>
        <h3>Address</h3>
        <p>Our registered office</p>
        <p>
          Sr. HIG 05, New Housing Board Colony,<br>
          Deorikhurd, Bilaspur 495004<br>
          India
        </p>
      </div>
    </div>

    <section class="info-section">
      <h2>How Can We Help?</h2>
      <p>
        Email us with questions about the app, subscription help, or bug reports.
        Describe the issue so we can help. We typically respond within 24-48 hours.
      </p>
      <p>
        For frequently asked questions, please visit our <a href="/google-keep-alternative">FAQ page</a>.
        For subscription and billing inquiries, check out our <a href="/cancellation-refund">Cancellation & Refund
          Policy</a>.
      </p>
    </section>
