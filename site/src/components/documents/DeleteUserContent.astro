      <h3>How to Export</h3>
      <div class="steps-container">
        <div class="step">
          <div class="step-number">1</div>
          <div class="step-content">
            <h4>Start the Deletion Process</h4>
            <p>Follow the account deletion steps above (go to Profile → Danger Zone → Delete My Account).</p>
          </div>
        </div>
        <div class="step">
          <div class="step-number">2</div>
          <div class="step-content">
            <h4>Complete Email Verification</h4>
            <p>Enter the 6-digit verification code sent to your email to confirm your identity.</p>
          </div>
        </div>
        <div class="step">
          <div class="step-number">3</div>
