---
interface Props {
  id: string;
  src: string;
  optimizedSrc: string;
  optimizedSrcset?: string;
  width: number;
  height: number;
  platform: string;
  alt: string;
  caption?: string;
  class?: string;
  priority?: boolean;
  label?: string;
}

const {
  id,
  src,
  optimizedSrc,
  optimizedSrcset,
  width,
  height,
  platform,
  alt,
  caption,
  class: className,
  priority = false,
  label
} = Astro.props;
---

<figure
  class:list={['device-frame', `device-frame--${platform}`, className]}
  data-device-frame
  data-screenshot-id={id}
>
  <div class="device-frame__hardware">
    {platform === 'ios' && <span class="device-frame__speaker" aria-hidden="true"></span>}
    <picture>
      <source srcset={optimizedSrcset || optimizedSrc} sizes={platform === 'desktop' ? '(max-width: 1000px) 90vw, 1000px' : '(max-width: 680px) 85vw, 360px'} type="image/webp" />
      <img
        src={src}
        width={width}
        height={height}
        loading={priority ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={priority ? 'high' : 'auto'}
        alt={alt}
      />
    </picture>
  </div>
  {
    (label || caption) && (
      <figcaption>
        {label && <strong>{label}</strong>}
        {caption && <span>{caption}</span>}
      </figcaption>
    )
  }
</figure>
