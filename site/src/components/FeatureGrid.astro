---
import { primaryFeatures } from '../data/home';
import Icon from './Icon.astro';
---

<section class="home-section feature-section" id="features">
  <div class="container">
    <div class="section-heading">
      <p class="eyebrow">Write, organize, and find</p>
      <h2>For lists, plans, and longer notes.</h2>
    </div>
    <div class="feature-grid">
      {
        primaryFeatures.map((feature) => (
          <a class="feature-card" href={feature.href}>
            <Icon name={feature.icon} size={24} strokeWidth={1.8} />
            <strong>{feature.title}</strong>
            <span>{feature.description}</span>
          </a>
        ))
      }
    </div>
  </div>
</section>
