---
import { heroScreenshots } from '../data/home';
import DeviceFrame from './DeviceFrame.astro';
import StoreActions from './StoreActions.astro';
import UserCount from './UserCount.astro';

const positions = ['left', 'primary', 'right'] as const;
---

<section class="home-hero">
  <div class="home-hero__inner container">
    <div class="home-hero__copy">
      <p class="eyebrow">Private, offline-friendly notes</p>
      <h1>Quick notes. <span>Room to think.</span></h1>
      <p class="home-hero__lede">
        Your free note-taking app for ideas, checklists, and everyday plans.
        Write offline with rich-text notes, photos, sketches, and voice recordings.
      </p>
      <div class="home-hero__actions">
        <StoreActions variant="hero" />
      </div>
    </div>

    <div class="hero-stage">
      <div class="hero-stage__screens" aria-label="Better Keep rich-text, notes home, and voice-note screens">
        <div class="hero-stage__backdrop" aria-hidden="true"></div>
        {
          heroScreenshots.map((screenshot, index) => (
            <DeviceFrame
              {...screenshot}
              priority={positions[index] === 'primary'}
              class={`hero-device hero-device--${positions[index]}`}
            />
          ))
        }
      </div>
    </div>
    <div class="home-hero__community"><UserCount /></div>
  </div>
</section>
