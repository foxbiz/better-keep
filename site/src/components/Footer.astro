---
import { product } from '../data/product';
---

<footer class="site-footer">
  <div class="footer-grid container">
    <div class="footer-about">
      <a class="brand" href="/" aria-label="Better Keep home">
        <img src="/media/brand/logo.svg" width="40" height="40" alt="" />
        <span>Better Keep</span>
      </a>
      <p>Private, offline notes with richer writing and optional encrypted sync.</p>
      <a href={`mailto:${product.supportEmail}`}>{product.supportEmail}</a>
    </div>
    <div class="footer-links">
      <strong>Product</strong>
      <a href={product.webAppUrl}>Open web app</a>
      <a href="/#features">Features</a>
      <a href="/#platforms">Platforms</a>
      <a href="/import/google-keep">Import from Google Keep</a>
      <a href="/pricing">Pricing</a>
    </div>
    <div class="footer-links">
      <strong>Learn</strong>
      <a href="/security">Security</a>
      <a href="/offline-notes-app">Offline notes</a>
      <a href="/rich-text-notes">Rich-text notes</a>
      <a href="/changelog">Changelog</a>
      <a href={product.githubUrl} data-analytics={product.analyticsGoals.github}>Source code</a>
    </div>
    <div class="footer-links">
      <strong>Company</strong>
      <a href="/contact">Contact</a>
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms</a>
      <a href="/cancellation-refund">Refunds</a>
      <a href="/delete-user">Delete an account</a>
    </div>
  </div>
  <div class="footer-bottom container">
    <p>© {new Date().getFullYear()} {product.publisher}</p>
    <a href={product.license.url}>{product.license.label}</a>
  </div>
</footer>
