---
import { buildUserMetric } from '../lib/build-user-count';
import Icon from './Icon.astro';

const metric = await buildUserMetric;
---

{
  metric && (
    <p class="user-count" data-user-count>
      <Icon name="Users" size={17} />
      <span><strong>{metric}</strong> people have joined</span>
    </p>
  )
}
