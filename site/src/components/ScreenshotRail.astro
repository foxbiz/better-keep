---
import { galleryScreenshots } from '../data/home';
import DeviceFrame from './DeviceFrame.astro';
---

<section class="home-section screenshot-gallery" id="screenshots">
  <div class="container">
    <div class="section-heading section-heading--split">
      <div>
        <p class="eyebrow">Personalize and connect</p>
        <h2 id="screenshot-gallery-title">Set up Better Keep your way.</h2>
      </div>
      <p>
        Choose a theme and language, sign in the way you prefer, and manage
        connected accounts and subscription details.
      </p>
    </div>
    <p class="device-gallery__hint" id="screenshot-gallery-hint">
      Swipe to explore the app screens
    </p>
    <div
      class="device-gallery"
      role="region"
      aria-labelledby="screenshot-gallery-title"
      aria-describedby="screenshot-gallery-hint"
      tabindex="0"
    >
      {
        galleryScreenshots.map((screenshot) => (
          <DeviceFrame {...screenshot} class="device-gallery__item" />
        ))
      }
    </div>
  </div>
</section>
