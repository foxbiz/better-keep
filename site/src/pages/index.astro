---
import BaseLayout from '../layouts/BaseLayout.astro';
import CallToAction from '../components/CallToAction.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import HomeHero from '../components/HomeHero.astro';
import MigrationSection from '../components/MigrationSection.astro';
import PlatformLinks from '../components/PlatformLinks.astro';
import ScreenshotRail from '../components/ScreenshotRail.astro';
import { product } from '../data/product';

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: product.publisher,
    url: product.siteUrl,
    logo: `${product.siteUrl}/media/brand/app-icon-512.png`,
    sameAs: [product.githubUrl]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: product.name,
    url: product.siteUrl,
    description: product.positioning,
    publisher: {
      '@type': 'Organization',
      name: product.publisher
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: product.storeName,
    alternateName: product.name,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: product.platforms.join(', '),
    description: product.shortDescription,
    url: product.siteUrl,
    downloadUrl: [product.appStoreUrl, product.playStoreUrl],
    author: {
      '@type': 'Organization',
      name: product.publisher
    },
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
      description: 'Free local note-taking with optional paid features'
    }
  }
];
---

<BaseLayout
  title="Better Keep Notes: Private notes, lists, and tables"
  description="Capture ideas with Better Keep, a free note-taking app for rich-text notes, checklists, photos, sketches, and voice recordings. Write and organize notes offline."
  canonicalPath="/"
  schemas={schemas}
>
  <HomeHero />
  <ScreenshotRail />
  <FeatureGrid />
  <PlatformLinks />
  <MigrationSection />
  <CallToAction />
</BaseLayout>
