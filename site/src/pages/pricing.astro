---
import PublicDocumentPage from '../components/PublicDocumentPage.astro';
import PricingContent from '../components/documents/PricingContent.astro';
import { getPublicDocument } from '../data/public-documents';
---

<PublicDocumentPage document={getPublicDocument('pricing')}>
  <PricingContent />
</PublicDocumentPage>

<script>
  import { isDesktopBrowser } from '../lib/native-app-action';

  const pricing = document.querySelector<HTMLElement>('.web-pricing');
  if (pricing && isDesktopBrowser(navigator)) pricing.hidden = false;
</script>
