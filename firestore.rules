rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user has an active Pro subscription
    // Uses custom claims set by Cloud Functions when subscription is verified
    function isPro() {
      return request.auth != null
        && request.auth.token.keys().hasAll(['plan', 'planExpiresAt'])
        && request.auth.token.plan == 'pro'
        && request.auth.token.planExpiresAt != null
        && request.auth.token.planExpiresAt > request.time.toMillis();
    }

    function hasAutomaticExternalSync() {
      return request.auth != null
        && request.auth.token.keys().hasAll(['plan', 'planExpiresAt'])
        && request.auth.token.plan in ['lite', 'pro']
        && request.auth.token.planExpiresAt != null
        && request.auth.token.planExpiresAt > request.time.toMillis();
    }

    function isReviewAccount() {
      return request.auth != null
        && (
          (
            request.auth.token.keys().hasAll(['appReview'])
            && request.auth.token.appReview == true
          )
          || (
            request.auth.token.keys().hasAll(['email'])
            && request.auth.token.email == 'review@betterkeep.app'
          )
        );
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isMutableOwner(userId) {
      return isOwner(userId) && !isReviewAccount();
    }

    // Public statistics - read-only access for user count badges
    // Only Cloud Functions can write via Admin SDK
    match /stats/public {
      allow read: if true;
      allow write: if false;
    }

    // Helper function to validate attachment count
    // Maximum 50 attachments per note to maintain performance and prevent storage abuse
    function hasValidAttachmentCount() {
      let attachments = request.resource.data.attachments;
      return !('attachments' in request.resource.data) || attachments == null || attachments.size() <= 50;
    }

    // New clients write request.time through a serverTimestamp transform.
    // Legacy clients may omit the marker or retain the previous value; a
    // backend trigger stamps those writes after commit.
    function hasValidSyncCommitMarkerOnCreate() {
      let data = request.resource.data;
      return !('sync_committed_at' in data)
        || (
          data.sync_committed_at is timestamp
          && data.sync_committed_at == request.time
        );
    }

    function hasValidSyncCommitMarkerOnUpdate() {
      let data = request.resource.data;
      return !('sync_committed_at' in data)
        || (
          data.sync_committed_at is timestamp
          && (
            data.sync_committed_at == request.time
            || (
              'sync_committed_at' in resource.data
              && data.sync_committed_at == resource.data.sync_committed_at
            )
          )
        );
    }

    function hasValidNoteSortManifest() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'schema_version',
          'sort_mode',
          'revision',
          'chunk_count',
          'note_count',
          'updated_at'
        ])
        && data.schema_version == 1
        && data.sort_mode in ['custom', 'createdNewest', 'updatedNewest']
        && data.revision is string
        && data.revision.size() > 0
        && data.revision.size() <= 64
        && data.chunk_count is int
        && data.chunk_count >= 0
        && data.chunk_count <= 500
        && data.note_count is int
        && data.note_count >= 0
        && data.note_count <= 1000000
        && (
          (data.chunk_count == 0 && data.note_count == 0)
          || (
            data.chunk_count > 0
            && data.note_count > (data.chunk_count - 1) * 2000
            && data.note_count <= data.chunk_count * 2000
          )
        )
        && data.updated_at is timestamp;
    }

    function hasValidNoteOrderChunk(revision) {
      let data = request.resource.data;
      return data.keys().hasOnly(['schema_version', 'revision', 'note_ids'])
        && data.schema_version == 1
        && data.revision == revision
        && data.note_ids is list
        && data.note_ids.size() <= 2000;
    }

    function hasValidContextOrderManifest(contextId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'schema_version',
          'context_key',
          'sort_mode',
          'revision',
          'chunk_count',
          'note_count',
          'updated_at',
          'content_hash',
          'sync_meta',
          'deleted'
        ])
        && data.schema_version == 2
        && data.context_key == contextId
        && data.context_key is string
        && data.context_key.size() > 0
        && data.context_key.size() <= 512
        && data.sort_mode in ['custom', 'createdNewest', 'updatedNewest']
        && data.revision is string
        && data.revision.size() > 0
        && data.revision.size() <= 256
        && data.chunk_count is int
        && data.chunk_count >= 0
        && data.chunk_count <= 500
        && data.note_count is int
        && data.note_count >= 0
        && data.note_count <= 1000000
        && (
          (data.chunk_count == 0 && data.note_count == 0)
          || (
            data.chunk_count > 0
            && data.note_count > (data.chunk_count - 1) * 2000
            && data.note_count <= data.chunk_count * 2000
          )
        )
        && data.updated_at is timestamp
        && (!('content_hash' in data) ||
            (data.content_hash is string && data.content_hash.matches('^[a-f0-9]{64}$')))
        && (!('sync_meta' in data) || data.sync_meta is map)
        && (!('deleted' in data) || (
          data.deleted == true && data.sort_mode == 'custom'
          && data.chunk_count == 0 && data.note_count == 0
          && data.content_hash == '4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945'
        ));
    }

    function hasValidContextOrderChunk(revision) {
      let data = request.resource.data;
      return data.keys().hasOnly(['schema_version', 'revision', 'note_ids'])
        && data.schema_version == 2
        && data.revision == revision
        && data.note_ids is list
        && data.note_ids.size() <= 2000;
    }

    // Match any document in the 'users' collection
    match /users/{userId} {
      // Allow creating/reading/updating/deleting the user document itself
      // ONLY if the request comes from the authenticated user with that UID
      allow read: if isOwner(userId);
      allow write: if isMutableOwner(userId);

      // Notes subcollection - requires Pro subscription for writes
      match /notes/{noteId} {
        // Allow reads for all authenticated owners (needed for migration/download)
        allow read: if isMutableOwner(userId);
        
        // Only Pro users can write (create/update) notes to the cloud
        // Also validates attachment count
        allow create: if isMutableOwner(userId)
          && isPro()
          && hasValidAttachmentCount()
          && hasValidSyncCommitMarkerOnCreate();
        allow update: if isMutableOwner(userId)
          && isPro()
          && hasValidAttachmentCount()
          && hasValidSyncCommitMarkerOnUpdate();
        
        // Allow deletes for Pro users OR if the note exists (cleanup)
        // This allows users to delete their cloud data even after subscription ends
        allow delete: if isMutableOwner(userId)
          && (isPro() || resource != null);
      }

      // Labels subcollection - same rules as notes
      match /labels/{labelId} {
        allow read: if isMutableOwner(userId);
        allow create: if isMutableOwner(userId)
          && isPro()
          && hasValidSyncCommitMarkerOnCreate();
        allow update: if isMutableOwner(userId)
          && isPro()
          && hasValidSyncCommitMarkerOnUpdate();
        allow delete: if isMutableOwner(userId)
          && (isPro() || resource != null);
      }

      match /preferences/{preferenceId} {
        allow read: if isMutableOwner(userId);
        allow create, update: if isMutableOwner(userId)
          && isPro()
          && preferenceId == 'note_sort'
          && hasValidNoteSortManifest();
        allow delete: if isMutableOwner(userId)
          && preferenceId == 'note_sort';
      }

      match /note_order_snapshots/{revision}/chunks/{chunkId} {
        allow read: if isMutableOwner(userId);
        allow create, update: if isMutableOwner(userId)
          && isPro()
          && hasValidNoteOrderChunk(revision);
        allow delete: if isMutableOwner(userId)
          && (isPro() || resource != null);
      }

      match /note_order_contexts/{contextId} {
        allow read: if isMutableOwner(userId);
        allow create, update: if isMutableOwner(userId)
          && isPro()
          && hasValidContextOrderManifest(contextId);
        allow delete: if isMutableOwner(userId)
          && (isPro() || resource != null);
      }

      match /note_order_context_snapshots/{revision}/chunks/{chunkId} {
        allow read: if isMutableOwner(userId);
        allow create, update: if isMutableOwner(userId)
          && isPro()
          && hasValidContextOrderChunk(revision);
        allow delete: if isMutableOwner(userId);
      }

      // Subscription subcollection - read only for owner, write only by Cloud Functions
      match /subscription/{document=**} {
        allow read: if isMutableOwner(userId);
        // Writes are handled by Cloud Functions with admin SDK, so deny client writes
        allow write: if false;
      }

      // Authentication authorization state is backend-only. Allowing an owner
      // to write these documents would let a modified client mint its own OTP
      // or provider-link authorization.
      match /otpVerification/{document=**} {
        allow read, write: if false;
      }

      match /pendingProviderLinks/{document=**} {
        allow read, write: if false;
      }

      match /auditLog/{document=**} {
        allow read, write: if false;
      }

      match /storage_credentials/{document=**} {
        allow read, write: if false;
      }

      match /sync_settings/{settingId} {
        allow read: if isMutableOwner(userId) && settingId == 'firebase';
        allow create, update: if isMutableOwner(userId)
          && settingId == 'firebase'
          && request.resource.data.keys().hasOnly(['enabled', 'provider', 'updatedAt'])
          && request.resource.data.enabled is bool
          && (!('provider' in request.resource.data) ||
            (request.resource.data.provider in ['firebase', 'google_drive', 'dropbox', 'nextcloud', 'webdav', 'none']
              && request.resource.data.enabled == (request.resource.data.provider == 'firebase')))
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      match /storage_connections/{document=**} {
        allow read: if isMutableOwner(userId);
        allow write: if false;
      }

      match /storage_sync_signals/{provider} {
        function validSignal() {
          let data = request.resource.data;
          let connection = get(/databases/$(database)/documents/users/$(userId)/storage_connections/$(provider)).data;
          return provider in ['google_drive', 'dropbox', 'nextcloud', 'webdav']
            && data.keys().hasOnly(['libraryId', 'generation', 'storageEpoch', 'deviceId', 'token', 'updatedAt'])
            && connection.enabled == true && connection.state == 'ready'
            && data.libraryId == connection.libraryId
            && data.generation == connection.generation
            && data.storageEpoch == connection.get('storageEpoch', '')
            && data.deviceId is string && data.deviceId.matches('[A-Za-z0-9_-]{1,128}')
            && data.token is string && data.token.size() > 0 && data.token.size() <= 128
            && data.updatedAt == request.time;
        }
        allow read: if isMutableOwner(userId) && hasAutomaticExternalSync();
        allow create: if isMutableOwner(userId) && hasAutomaticExternalSync() && validSignal();
        allow update: if isMutableOwner(userId) && hasAutomaticExternalSync() && validSignal()
          && (request.resource.data.generation != resource.data.generation
            || request.resource.data.storageEpoch != resource.data.storageEpoch
            || request.time >= resource.data.updatedAt + duration.value(10, 's'));
        allow delete: if false;
      }

      // Other subcollections (settings, preferences, etc.) - allow for owner
      match /{subcollection}/{document=**} {
        // Exclude notes, labels, and subscription which have specific rules above
        allow read, write: if isMutableOwner(userId)
          && !(subcollection in [
            'notes',
            'labels',
            'subscription',
            'otpVerification',
            'pendingProviderLinks',
            'auditLog',
            'storage_credentials',
            'storage_connections',
            'storage_sync_signals',
            'sync_settings',
            'preferences',
            'note_order_snapshots',
            'note_order_contexts',
            'note_order_context_snapshots'
          ]);
      }
    }

    // Global subscriptions collection - used for subscription lookups
    // Only Cloud Functions should write here
    match /subscriptions/{subscriptionId} {
      allow read: if false; // Only backend access
      allow write: if false; // Only backend access
    }

    // Backend-only admin data. Browser clients use authorized Cloud Functions.
    match /adminUsers/{document=**} {
      allow read, write: if false;
    }

    match /adminMetrics/{document=**} {
      allow read, write: if false;
    }

    match /adminRevenueTransactions/{document=**} {
      allow read, write: if false;
    }

    match /adminRevenueSummary/{document=**} {
      allow read, write: if false;
    }

    match /adminAuditLogs/{document=**} {
      allow read, write: if false;
    }

    match /adminRevenueEvents/{document=**} {
      allow read, write: if false;
    }

    match /adminSubscriptionIssues/{document=**} {
      allow read, write: if false;
    }

    match /adminBillingActivities/{document=**} {
      allow read, write: if false;
    }

    match /playStoreWebhookEvents/{document=**} {
      allow read, write: if false;
    }

    match /razorpayWebhookEvents/{document=**} {
      allow read, write: if false;
    }

    // Payments collection - only Cloud Functions should access
    match /storageOAuthSessions/{document=**} {
      allow read, write: if false;
    }

    match /payments/{paymentId} {
      allow read: if false;
      allow write: if false;
    }

    // Shares collection - for note sharing feature
    match /shares/{shareId} {
      // Anyone can read to check share status (encrypted content is safe)
      allow read: if true;
      
      // Only authenticated owner can create/update/delete shares
      allow create: if request.auth != null
        && !isReviewAccount()
        && request.resource.data.owner_uid == request.auth.uid;
      
      allow update: if request.auth != null
        && !isReviewAccount()
        && resource.data.owner_uid == request.auth.uid;
      
      allow delete: if request.auth != null
        && !isReviewAccount()
        && resource.data.owner_uid == request.auth.uid;
      
      // Access requests subcollection
      match /requests/{requestId} {
        // Owner can read all requests
        // Anyone can read a specific request (to check their own status)
        allow read: if true;
        
        // Anyone can create a request (to request access)
        allow create: if !isReviewAccount()
          && request.resource.data.status == 'pending';
        
        // Only owner can update (approve/deny)
        allow update: if request.auth != null
          && !isReviewAccount()
          && get(/databases/$(database)/documents/shares/$(shareId)).data.owner_uid == request.auth.uid;
        
        // Only owner can delete requests
        allow delete: if request.auth != null
          && !isReviewAccount()
          && get(/databases/$(database)/documents/shares/$(shareId)).data.owner_uid == request.auth.uid;
      }
    }
  }
}
