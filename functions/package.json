{
	"name": "better-keep-functions",
	"description": "Cloud Functions for Better Keep",
	"scripts": {
		"build": "tsc",
		"typecheck:scripts": "tsc --project tsconfig.scripts.json",
		"test": "node scripts/runTests.mjs",
		"validate:deploy-env": "node scripts/validateDeploymentEnv.mjs",
		"test:deletion": "bash ../tool/test_account_deletion.sh",
		"test:emulator": "node scripts/runTests.mjs emulator",
		"build:watch": "tsc --watch",
		"admin:bootstrap": "npx tsx scripts/bootstrapAdmin.ts",
		"admin:backfill": "npx tsx scripts/backfillAdminData.ts",
		"admin:reconcile-billing": "node ../tool/run_billing_reconciliation.mjs",
		"admin:reconcile-play": "node ../tool/run_billing_reconciliation.mjs --provider=play",
		"serve": "npm --prefix .. run functions serve",
		"shell": "npm --prefix .. run functions shell",
		"start": "npm run shell",
		"deploy": "npm --prefix .. run deploy backend",
		"logs": "npm --prefix .. run functions logs"
	},
	"main": "lib/index.js",
	"dependencies": {
		"csv-parse": "^7.0.2",
		"fflate": "^0.8.2",
		"firebase-admin": "^12.0.0",
		"firebase-functions": "^7.3.2",
		"googleapis": "^144.0.0",
		"jose": "^5.9.6",
		"nodemailer": "^10.0.9"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.4",
		"@types/node": "^22.0.0",
		"@types/nodemailer": "^6.4.14",
		"tsx": "^4.23.11",
		"typescript": "^5.3.0"
	},
	"overrides": {
		"@tootallnate/once": "^2.0.1",
		"protobufjs": "^7.6.5",
		"uuid": "^11.1.1"
	},
	"private": true
}
