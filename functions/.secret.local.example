# Emulator-only confidential Google Web OAuth client secret.
# Never include this file or secret in a Flutter build.
GOOGLE_DRIVE_CLIENT_SECRET=REPLACE_WITH_WEB_OAUTH_CLIENT_SECRET
# Production: firebase functions:secrets:set GOOGLE_DRIVE_CLIENT_SECRET
# Provider tokens are encrypted by the client before storage. Exchange/refresh
# functions see them transiently but do not persist or log them.
# Keep unrelated existing secrets in your gitignored .secret.local.
