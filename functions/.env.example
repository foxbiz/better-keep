# Run the following commands to set secrets:
# firebase functions:secrets:set EMAIL_PASSWORD
# RAZORPAY_KEY_ID
# RAZORPAY_KEY_SECRET
# RAZORPAY_WEBHOOK_SECRET
# RAZORPAY_WEBHOOK_SECRET_PREVIOUS (temporary during webhook-secret rotation)

EMAIL_USER=contact@betterkeep.app
EMAIL_FROM=noreply@betterkeep.app
EMAIL_NAME=Better Keep Notes

# Google Play Console financial-report bucket. This is account-scoped and is
# safe to keep as non-secret Functions configuration.
GOOGLE_PLAY_REPORT_BUCKET=gs://pubsite_prod_7966583793961491942

# Trial configuration
# Set to "true" to enable 30-day Pro trial for new users
TRIAL_ENABLED=true
TRIAL_DAYS=30

# Debug mode: Set to number of minutes for testing (e.g., 1 for 1-minute trial)
# Comment out or remove in production
DEBUG_TRIAL_MINUTES=30

EMAIL_HOST=
EMAIL_PORT=465
EMAIL_SECURE=true
ADMIN_ACCOUNT_UID=
